+const AGENT_EVIDENCE_KEY='game_vault_agent_evidence_use_v1';
+const AGENT_TRACE_KEY='game_vault_agent_trace_v1';
+let agentLastTurnMeta={capability:null,evidenceIds:[],confidence:'unknown',actionState:'proposed'};
+function agentRedactTraceText(s=''){
+ return String(s).replace(/(?:ghp_|github_pat_|sk-)[A-Za-z0-9_\-]{8,}/g,'[SECRET_REDACTED]').replace(/Bearer\s+[A-Za-z0-9._\-]+/gi,'Bearer [REDACTED]').slice(0,2200);
+}
+function agentEvidenceHistory(){try{const v=JSON.parse(storageGet(AGENT_EVIDENCE_KEY)||'[]');return Array.isArray(v)?v:[]}catch(e){return []}}
+function agentTraceHistory(){try{const v=JSON.parse(storageGet(AGENT_TRACE_KEY)||'[]');return Array.isArray(v)?v:[]}catch(e){return []}}
+function recordAgentEvidenceUse(query,ids=[]){
+ const clean=[...new Set(ids)].filter(id=>AGENT_KNOWLEDGE_SOURCES.some(x=>x.id===id));if(!clean.length)return;
+ const list=agentEvidenceHistory();list.push({at:new Date().toISOString(),query:agentRedactTraceText(query).slice(0,500),sources:clean});storageSet(AGENT_EVIDENCE_KEY,JSON.stringify(list.slice(-80)));
+}
+function recordAgentTrace({query,answer,ctx,capability,evidenceIds=[],confidence='unknown',actionState='proposed'}){
+ const list=agentTraceHistory();list.push({schema:'GVAULT_AGENT_TRACE_V1',at:new Date().toISOString(),query:agentRedactTraceText(query).slice(0,800),answer:agentRedactTraceText(answer),surface:ctx?.surface||'vault',projectId:ctx?.project?.id||null,capability:capability||null,evidenceIds:[...new Set(evidenceIds)],confidence,actionState});storageSet(AGENT_TRACE_KEY,JSON.stringify(list.slice(-160)));
+}
+function agentKnowledgeSearch(q,limit=3){
+ const n=agentNorm(q),words=agentWords(q).filter(w=>w.length>2&&!AGENT_STOP_WORDS.has(w));
+ const scored=AGENT_KNOWLEDGE_SOURCES.map(src=>{
+  const title=agentNorm(src.title),path=agentNorm(src.path),tags=(src.tags||[]).map(agentNorm),facts=agentNorm((src.facts||[]).join(' '));let score=0;
+  for(const t of tags){if(t&&n.includes(t))score+=Math.max(5,Math.min(14,t.length));}
+  for(const w of words){if(title.includes(w))score+=4;if(path.includes(w))score+=3;if(tags.some(t=>t.includes(w)))score+=3;if(facts.includes(w))score+=1;}
+  if(agentNorm(src.id)===n)score+=20;
+  return {src,score};
+ }).filter(x=>x.score>=5).sort((a,b)=>b.score-a.score||a.src.id.localeCompare(b.src.id));
+ return scored.slice(0,limit);
+}
+function agentKnowledgeIntent(q){
+ const n=agentNorm(q);
+ return /github|rollback|undo|revert|action.?ledger|vigie|che.?kca|fic.?sa|workflow conversation|trace conversation|private first|import prive|projet prive|publication.*prive|preview officielle|gateway|sas|branche source|provenance|preuve|unproven|gdata.*mobile|audit gvault/.test(n);
+}
+function agentKnowledgeAnswer(q){
+ if(!agentKnowledgeIntent(q))return null;
+ const hits=agentKnowledgeSearch(q,3);if(!hits.length)return null;
+ const top=hits[0],sources=hits.map(x=>x.src);
+ agentLastTurnMeta.evidenceIds=sources.map(x=>x.id);agentLastTurnMeta.confidence=top.src.confidence||'confirmed';agentLastTurnMeta.capability='private-knowledge';
+ const facts=sources.flatMap(s=>(s.facts||[]).slice(0,s===top.src?4:2)).filter((x,i,a)=>a.indexOf(x)===i).slice(0,7);
+ const provenance=sources.map(s=>`- ${s.id} · ${s.status} · ${s.path} · ${s.sha.slice(0,12)}…`).join('\n');
+ return `CONNAISSANCE GVAULT · ${top.src.title}\nConfiance : ${String(top.src.confidence||'confirmed').toUpperCase()}\n\n${facts.map(x=>'• '+x).join('\n')}\n\nPROVENANCE\n${provenance}\n\nNote : snapshot local sanitisé du dépôt privé au ${AGENT_KNOWLEDGE_SNAPSHOT_AT}; ce runtime ne lit pas GitHub en direct.`;
+}
+function agentSelfHealth(){
+ const recentFaults=agentFaultHistory().filter(x=>Date.now()-(Number(x.atMs)||0)<=AGENT_FAULT_WINDOW_MS);
+ return `ÉTAT AGENT\nCircuit : ${agentCircuitOpen?'COUPÉ':'ACTIF'}\nMode : ${agentModelLabel()}\nProjets : ${projects.length}\nSources de connaissance : ${AGENT_KNOWLEDGE_SOURCES.length}\nPreuves consultées localement : ${agentEvidenceHistory().length}\nTraces : ${agentTraceHistory().length}\nRègles apprises : ${agentRuleLibrary().length}\nBacklog : ${agentLearningBacklog().length}\nNotifications non lues : ${agentUnreadNotifications().length}\nDéfauts récents : ${recentFaults.length}/${AGENT_FAULT_BUDGET}\nRéseau privé : DÉSACTIVÉ PAR DÉFAUT · snapshot local uniquement`;
+}
 
