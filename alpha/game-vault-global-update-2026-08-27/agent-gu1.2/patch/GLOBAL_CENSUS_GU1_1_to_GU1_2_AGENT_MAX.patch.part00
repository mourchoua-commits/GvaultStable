+const AGENT_FAULT_KEY='game_vault_agent_faults_v2';
+const AGENT_FAULT_WINDOW_MS=30000;
+const AGENT_FAULT_BUDGET=3;
+const AGENT_CRITICAL_PHASES=new Set(['context-init','send-message','send-message-enter','manual-reactivation']);
+function agentFaultHistory(){
+ try{const v=JSON.parse(storageGet(AGENT_FAULT_KEY)||'[]');return Array.isArray(v)?v:[]}
+ catch(e){return []}
+}
+function saveAgentFaultHistory(list){storageSet(AGENT_FAULT_KEY,JSON.stringify((Array.isArray(list)?list:[]).slice(-40)))}
+function recordAgentFault(err,phase){
+ const now=Date.now(),list=agentFaultHistory().filter(x=>now-(Number(x.atMs)||0)<86400000);
+ list.push({phase:String(phase||'unknown').slice(0,80),message:String(err?.message||err).slice(0,500),at:new Date(now).toISOString(),atMs:now});
+ saveAgentFaultHistory(list);return list;
+}
+function handleAgentFault(err,phase='unknown'){
+ const list=recordAgentFault(err,phase),now=Date.now();
+ const recent=list.filter(x=>now-(Number(x.atMs)||0)<=AGENT_FAULT_WINDOW_MS);
+ const critical=AGENT_CRITICAL_PHASES.has(String(phase));
+ if(critical||recent.length>=AGENT_FAULT_BUDGET){shutdownAgent(err,phase);return 'shutdown'}
+ try{
+  agentCrashReportText=buildAgentCrashReport(err,phase)+`
+
+Mode : DEGRADE_NON_FATAL
+Budget : ${recent.length}/${AGENT_FAULT_BUDGET} sur ${AGENT_FAULT_WINDOW_MS/1000}s`;
+  storageSet(AGENT_CRASH_KEY,agentCrashReportText);
+  showToast(`Agent dégradé · ${phase} · ${recent.length}/${AGENT_FAULT_BUDGET}`);
+ }catch(reportErr){console.error('AGENT DEGRADED REPORT',reportErr)}
+ console.error('VAULT AGENT NONFATAL',phase,err);return 'degraded';
+}
 function safeAgentExec(phase,fn){
  if(agentCircuitOpen){openAgentCrashReport();return undefined}
  agentExecutionDepth++;
  try{return fn()}
- catch(e){shutdownAgent(e,phase);return undefined}
+ catch(e){handleAgentFault(e,phase);return undefined}
  finally{agentExecutionDepth=Math.max(0,agentExecutionDepth-1)}
 }
 function safeAgentAsync(phase,fn){
  if(agentCircuitOpen){openAgentCrashReport();return Promise.resolve(undefined)}
  agentExecutionDepth++;
- return Promise.resolve().then(fn).catch(e=>{shutdownAgent(e,phase)}).finally(()=>{agentExecutionDepth=Math.max(0,agentExecutionDepth-1)});
+ return Promise.resolve().then(fn).catch(e=>{handleAgentFault(e,phase)}).finally(()=>{agentExecutionDepth=Math.max(0,agentExecutionDepth-1)});
 }
 
 
